{
  "manifest_version": 3,
  "name": "No Exceeding Awful Tabs",
  "version": "1.0",
  "description": "Принудительно открывает ссылки в текущей вкладке.",
  "icons": {
    "48": "design/icon-48.png",
    "128": "design/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["neat.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}